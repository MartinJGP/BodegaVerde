# ==============================================
# La Bodega Verde - Frontend Environment Variables
# ==============================================

# URL de la API REST del backend NestJS
# Desarrollo local: http://localhost:3001
# Producción (Vercel): Cambiar a la URL pública del backend (ej. https://bodega-verde-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL de conexión WebSocket (Socket.io)
# Desarrollo local: http://localhost:3001
# Producción (Vercel): Cambiar a la URL pública del backend (ej. https://bodega-verde-backend.onrender.com)
NEXT_PUBLIC_WS_URL=http://localhost:3001
