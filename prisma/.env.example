# ==============================================
# La Bodega Verde - Backend Environment Variables
# ==============================================

# URL de conexión a la base de datos PostgreSQL (Supabase, Neon, AWS RDS o Local)
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Puerto de ejecución del backend NestJS
PORT=3001

# Secreto para tokens JWT
JWT_SECRET="bodega_verde_super_secret_jwt_key_2026"
